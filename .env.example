# Local defaults: persistence is independent of processing.
DATABASE_PROVIDER=mongodb
OBJECT_STORE_PROVIDER=mongodb
LLM_PROVIDER=mock
WORKFLOW_PROVIDER=mock
EMAIL_PROVIDER=disabled
USE_MOCK_AWS=false
APP_ENV=development
# Legacy per-dimension flags apply only when the corresponding provider is absent.
# USE_MOCK_AWS=false never selects AWS. Unknown/blank providers are errors.
USE_REAL_DATABASE=false
USE_REAL_STORAGE=false
USE_REAL_LLM=false
CASESEVA_AWS_REGION=ap-southeast-2
DYNAMODB_TABLE_NAME=caseseva-data-dev
S3_BUCKET_NAME=
BEDROCK_MODEL_ID=
ADMIN_TOKEN=
# Comma-separated official credential-review hosts, registered by the operator.
ADMIN_VERIFICATION_HOSTS=
OTP_FROM_EMAIL=
CASE_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=2555
ENABLE_AWS_MEDIA=false
MEDIA_S3_BUCKET=
ALLOWED_ORIGIN=http://127.0.0.1:5173
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000
